# Copiá este archivo como .env y completá los valores para tu entorno local
# cp .env.example .env  (Mac/Linux)  |  copy .env.example .env  (Windows)

# Base de datos
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu_password_de_mysql
DB_NAME=contactos_db

# Servidor
PORT=3000

# JWT — usá una clave larga y aleatoria, no la compartas
JWT_SECRET=cambiar_por_clave_secreta_larga

# Clave para crear usuarios admin vía POST /register
